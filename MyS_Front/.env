# MyS_Front\.env

# Configuración para React Dev Server con HTTPS

# Habilitar HTTPS en React Dev Server
HTTPS=true

# Rutas a certificados (ajusta según tu ubicación)
SSL_CRT_FILE=C:/certs/localhost.pem
SSL_KEY_FILE=C:/certs/localhost-key.pem

# URL de la API (para uso en componentes si es necesario)
REACT_APP_API_URL=https://localhost/api

# Puerto del dev server (opcional, por defecto 3000)
PORT=3000

# Modo desarrollo
NODE_ENV=development